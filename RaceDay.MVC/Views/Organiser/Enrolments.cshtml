@model EventEnrolmentsViewModel
@{
    var e = Model.Event;
    ViewData["Title"] = "Enrolments";
}
<a asp-action="Events" class="back-link"><i class="bi bi-arrow-left"></i> My events</a>
<h1 class="page-title mt-2"><i class="bi bi-people"></i> Enrolments <span class="text-muted fs-4">- @e.EventName</span></h1>
<p class="text-muted"><i class="bi bi-calendar3"></i> @UiHelpers.Date(e.EventDate) &nbsp;&middot;&nbsp; <i class="bi bi-geo-alt-fill"></i> @e.Location &nbsp;&middot;&nbsp; @Model.Enrolments.Count @(Model.Enrolments.Count == 1 ? "participant" : "participants")</p>

@if (Model.Enrolments.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-person-plus"></i>
        <h2>No enrolments yet</h2>
        <p>Participants who enter this event will appear here.</p>
    </div>
}
else
{
    <div class="table-responsive rd-table-wrap">
        <table class="table rd-table align-middle mb-0">
            <thead><tr><th>Participant</th><th>Contact</th><th>Category</th><th>Entered on</th><th>Status</th><th>Result</th></tr></thead>
            <tbody>
            @foreach (var n in Model.Enrolments)
            {
                <tr>
                    <td class="fw-semibold">@n.ParticipantName</td>
                    <td class="small">
                        <div><i class="bi bi-envelope"></i> @n.ParticipantEmail</div>
                        @if (!string.IsNullOrWhiteSpace(n.EmergencyContact))
                        {
                            <div class="text-muted"><i class="bi bi-telephone"></i> @n.EmergencyContact</div>
                        }
                    </td>
                    <td>@n.CategoryName</td>
                    <td>@UiHelpers.Date(n.EnrolmentDate)</td>
                    <td><partial name="_StatusBadge" model="n.Status" /></td>
                    <td>
                        @if (n.HasResult)
                        {
                            <span class="time-cell">@UiHelpers.FormatTime(n.FinishTime)</span>
                            @if (n.Position is { } p) { <span class="text-muted small"> (@UiHelpers.Ordinal(p))</span> }
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="mt-3"><a asp-action="Results" asp-route-id="@e.EventId" class="btn btn-rd"><i class="bi bi-stopwatch"></i> Enter results</a></p>
}
