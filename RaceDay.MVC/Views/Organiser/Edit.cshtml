@model EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}
<a asp-action="Events" class="back-link"><i class="bi bi-arrow-left"></i> My events</a>
<h1 class="page-title mt-2"><i class="bi bi-pencil-square"></i> Edit event</h1>
<div class="card form-card">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
            <partial name="_EventFormFields" model="Model" />
            <button type="submit" class="btn btn-rd btn-lg"><i class="bi bi-save"></i> Save changes</button>
            <a asp-action="Categories" asp-route-id="@Model.EventId" class="btn btn-outline-secondary">Manage categories</a>
            <a asp-action="Events" class="btn btn-link text-muted">Cancel</a>
        </form>
    </div>
</div>
