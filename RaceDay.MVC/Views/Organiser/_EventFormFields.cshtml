@model EventFormViewModel
@{
    var isCreate = Model.EventId is null;
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="EventName" class="form-label">Event name</label>
        <input asp-for="EventName" class="form-control" placeholder="e.g. Centurion Sunrise Run" />
        <span asp-validation-for="EventName" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="EventType" class="form-label">Event type</label>
        <select asp-for="EventType" class="form-select">
            <option value="Run">Run</option>
            <option value="Walk">Walk</option>
            <option value="Cycle">Cycle</option>
        </select>
        <span asp-validation-for="EventType" class="text-danger small"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="EventDate" class="form-label">Date</label>
        <input asp-for="EventDate" type="date" class="form-control" />
        <span asp-validation-for="EventDate" class="text-danger small"></span>
    </div>
    <div class="col-md-8 mb-3">
        <label asp-for="Location" class="form-label">Location</label>
        <input asp-for="Location" class="form-control" placeholder="e.g. Centurion, Gauteng" />
        <span asp-validation-for="Location" class="text-danger small"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label">Description</label>
    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Tell participants what to expect: route, start time, facilities..."></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

@if (isCreate)
{
    <div class="p-3 mb-3 rounded-3 bg-light border">
        <h2 class="h6 mb-3"><i class="bi bi-signpost-split text-rd-orange"></i> Main distance <span class="text-muted fw-normal">(this creates the first category; you can add more later)</span></h2>
        <div class="row">
            <div class="col-md-4 mb-2">
                <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
                <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" placeholder="e.g. 10" />
                <span asp-validation-for="DistanceKm" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-2">
                <label asp-for="MaxParticipants" class="form-label">Places available</label>
                <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                <span asp-validation-for="MaxParticipants" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-2">
                <label asp-for="EntryFee" class="form-label">Entry fee (R)</label>
                <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="EntryFee" class="text-danger small"></span>
            </div>
        </div>
    </div>
}

<div class="mb-4">
    <label for="banner" class="form-label">Event banner image <span class="text-muted fw-normal">(optional, JPG/PNG/GIF/WEBP, up to 5 MB)</span></label>
    @if (!isCreate && Model.HasBanner)
    {
        <div class="mb-2">
            <img src="@Url.Action("EventBanner", "Media", new { id = Model.EventId })?v=@DateTime.UtcNow.Ticks" alt="Current banner" class="banner-preview" />
            <div class="form-text">Choose a new file below to replace this banner.</div>
        </div>
    }
    <input type="file" id="banner" name="banner" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" />
</div>
