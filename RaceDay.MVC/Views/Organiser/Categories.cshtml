@model CategoriesPageViewModel
@{
    var e = Model.Event;
    ViewData["Title"] = "Categories";
}
<a asp-action="Events" class="back-link"><i class="bi bi-arrow-left"></i> My events</a>
<h1 class="page-title mt-2"><i class="bi bi-list-check"></i> Categories <span class="text-muted fs-4">- @e.EventName</span></h1>
<p class="text-muted"><i class="bi bi-calendar3"></i> @UiHelpers.Date(e.EventDate) &nbsp;&middot;&nbsp; <i class="bi bi-geo-alt-fill"></i> @e.Location</p>

<div class="row g-4">
    <div class="col-lg-7">
        <h2 class="section-title mt-0">Current categories</h2>
        @if (e.Categories.Count == 0)
        {
            <div class="empty-state small-empty"><i class="bi bi-list-check"></i><p class="mb-0">No categories yet. Add one with the form.</p></div>
        }
        else
        {
            <div class="table-responsive rd-table-wrap">
                <table class="table rd-table align-middle mb-0">
                    <thead><tr><th>Category</th><th>Distance</th><th>Fee</th><th>Entered</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var c in e.Categories)
                    {
                        <tr>
                            <td class="fw-semibold">@c.CategoryName</td>
                            <td>@c.DistanceKm.ToString("0.##") km</td>
                            <td>@UiHelpers.Money(c.EntryFee)</td>
                            <td>@c.EnrolledCount / @c.MaxParticipants</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="EditCategory" asp-route-id="@e.EventId" asp-route-categoryId="@c.CategoryId" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <form asp-action="DeleteCategory" method="post" class="d-inline" data-confirm="Remove the category @c.CategoryName?" onsubmit="return confirm(this.dataset.confirm);">
                                    <input type="hidden" name="eventId" value="@e.EventId" />
                                    <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <div class="mt-3 d-flex gap-2">
            <a asp-action="Enrolments" asp-route-id="@e.EventId" class="btn btn-outline-rd"><i class="bi bi-people"></i> View enrolments</a>
            <a asp-action="Results" asp-route-id="@e.EventId" class="btn btn-outline-secondary"><i class="bi bi-stopwatch"></i> Enter results</a>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card form-card">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Add a category</h2>
                <form asp-action="AddCategory" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <input type="hidden" asp-for="NewCategory.EventId" />
                    <div class="mb-3">
                        <label asp-for="NewCategory.CategoryName" class="form-label">Name</label>
                        <input asp-for="NewCategory.CategoryName" class="form-control" placeholder="e.g. 10km, 21km, Under 20" />
                        <span asp-validation-for="NewCategory.CategoryName" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="NewCategory.DistanceKm" class="form-label">Distance (km)</label>
                            <input asp-for="NewCategory.DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="NewCategory.DistanceKm" class="text-danger small"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="NewCategory.MaxParticipants" class="form-label">Places</label>
                            <input asp-for="NewCategory.MaxParticipants" type="number" min="1" class="form-control" />
                            <span asp-validation-for="NewCategory.MaxParticipants" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewCategory.EntryFee" class="form-label">Entry fee (R)</label>
                        <input asp-for="NewCategory.EntryFee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="NewCategory.EntryFee" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-rd w-100"><i class="bi bi-plus-lg"></i> Add category</button>
                </form>
            </div>
        </div>
    </div>
</div>
