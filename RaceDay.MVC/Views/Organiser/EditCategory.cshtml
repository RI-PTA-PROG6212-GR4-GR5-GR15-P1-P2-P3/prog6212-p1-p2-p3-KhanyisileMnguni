@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}
<a asp-action="Categories" asp-route-id="@Model.EventId" class="back-link"><i class="bi bi-arrow-left"></i> Categories@(ViewData["EventName"] is string name ? " - " + name : "")</a>
<h1 class="page-title mt-2"><i class="bi bi-pencil-square"></i> Edit category</h1>
<div class="card form-card" style="max-width:640px">
    <div class="card-body p-4">
        <form asp-action="EditCategory" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <input type="hidden" asp-for="EventId" />
            <input type="hidden" asp-for="CategoryId" />
            <div class="mb-3">
                <label asp-for="CategoryName" class="form-label">Name</label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
                    <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
                    <span asp-validation-for="DistanceKm" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="MaxParticipants" class="form-label">Places</label>
                    <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                    <span asp-validation-for="MaxParticipants" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="EntryFee" class="form-label">Entry fee (R)</label>
                    <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="EntryFee" class="text-danger small"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-rd"><i class="bi bi-save"></i> Save category</button>
            <a asp-action="Categories" asp-route-id="@Model.EventId" class="btn btn-link text-muted">Cancel</a>
        </form>
    </div>
</div>
