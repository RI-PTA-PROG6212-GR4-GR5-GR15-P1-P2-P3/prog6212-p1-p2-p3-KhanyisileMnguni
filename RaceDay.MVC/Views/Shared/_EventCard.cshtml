@model EventResponse
@{
    var image = Model.HasBanner
        ? Url.Action("EventBanner", "Media", new { id = Model.EventId })
        : Url.Content("~/images/event-placeholder.svg");
    var description = string.IsNullOrWhiteSpace(Model.Description) ? "" :
        (Model.Description.Length > 110 ? Model.Description[..110].TrimEnd() + "..." : Model.Description);
}
<div class="col">
    <article class="card event-card h-100">
        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="event-card-img">
            <img src="@image" alt="Banner for @Model.EventName" loading="lazy" />
            <span class="type-pill"><i class="bi @UiHelpers.TypeIcon(Model.EventType)"></i> @Model.EventType</span>
        </a>
        <div class="card-body d-flex flex-column">
            <h3 class="event-title">@Model.EventName</h3>
            <ul class="event-meta list-unstyled mb-2">
                <li><i class="bi bi-calendar3"></i> @UiHelpers.Date(Model.EventDate)</li>
                <li><i class="bi bi-geo-alt-fill"></i> @Model.Location</li>
                <li><i class="bi bi-building"></i> @(string.IsNullOrWhiteSpace(Model.OrganisationName) ? Model.OrganiserName : Model.OrganisationName)</li>
            </ul>
            @if (description.Length > 0)
            {
                <p class="text-muted small flex-grow-1">@description</p>
            }
            <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-rd mt-auto">View event <i class="bi bi-arrow-right"></i></a>
        </div>
    </article>
</div>
