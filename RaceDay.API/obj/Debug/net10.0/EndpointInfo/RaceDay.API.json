{
  "openapi": "3.0.4",
  "info": {
    "title": "RaceDay.API",
    "description": "RESTful API for the RaceDay event management system. Register, log in, then click Authorize and paste the returned JWT token.",
    "version": "v1"
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Registers a new user as an Organiser or a Participant.",
        "description": "Expects name, email, password (min 8 chars) and role (\"Organiser\" or \"Participant\").\r\nOrganisers may add organisationName. Participants must add dateOfBirth and may add emergencyContact.\r\nThe password is stored as a salted hash.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Returns the new user ID and role.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing fields."
          },
          "409": {
            "description": "Email already in use."
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logs a user in and returns a JWT access token.",
        "description": "Copy the returned token, click the Authorize button in Swagger and paste it in.\r\nIt is then sent as \"Authorization: Bearer {token}\" on every request. The token carries the user's ID and role.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns the JWT token, its expiry, and the user ID, role and name.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials."
          }
        }
      }
    },
    "/api/categories/{id}": {
      "put": {
        "tags": [
          "Categories"
        ],
        "summary": "Updates a category. Only the Organiser who owns its event may do this.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated category.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not the owning Organiser."
          },
          "404": {
            "description": "Category not found."
          }
        }
      },
      "delete": {
        "tags": [
          "Categories"
        ],
        "summary": "Removes a category from an event. Owning Organiser only.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "204": {
            "description": "Deleted."
          },
          "403": {
            "description": "Not the owning Organiser."
          },
          "404": {
            "description": "Category not found."
          },
          "409": {
            "description": "The category already has enrolments."
          }
        }
      }
    },
    "/api/categories/{id}/enrolments": {
      "post": {
        "tags": [
          "Categories"
        ],
        "summary": "Enrols the logged-in Participant into a category.",
        "description": "The body is optional; the server records today's date as the enrolment date.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrolRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrolRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EnrolRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new enrolment.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/EnrolmentResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrolmentResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrolmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "The event has already taken place."
          },
          "403": {
            "description": "Logged in as an Organiser."
          },
          "404": {
            "description": "Category not found."
          },
          "409": {
            "description": "Category is full, or you are already enrolled in it."
          }
        }
      }
    },
    "/api/enrolments/customer": {
      "get": {
        "tags": [
          "Enrolments"
        ],
        "summary": "Lists the logged-in Participant's enrolments, with event and category details.",
        "responses": {
          "200": {
            "description": "Array of enrolments.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EnrolmentResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EnrolmentResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EnrolmentResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Logged in as an Organiser."
          }
        }
      }
    },
    "/api/enrolments/{id}": {
      "delete": {
        "tags": [
          "Enrolments"
        ],
        "summary": "Cancels one of the logged-in Participant's own enrolments.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "204": {
            "description": "Cancelled."
          },
          "403": {
            "description": "Not your enrolment."
          },
          "404": {
            "description": "Enrolment not found."
          },
          "409": {
            "description": "A result has already been captured, so it cannot be cancelled."
          }
        }
      }
    },
    "/api/enrolments/{id}/result": {
      "post": {
        "tags": [
          "Enrolments"
        ],
        "summary": "Captures a result (finish time, position, status) for an enrolment. Owning Organiser only.",
        "description": "Body: finishTime (hh:mm:ss), position, status (Finished / DNF / DNS / Disqualified). A finishTime is required when status is Finished.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResultRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ResultRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ResultRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new result.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResultResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields."
          },
          "403": {
            "description": "The enrolment is not in one of your events."
          },
          "404": {
            "description": "Enrolment not found."
          },
          "409": {
            "description": "A result already exists for this enrolment."
          }
        }
      },
      "get": {
        "tags": [
          "Enrolments"
        ],
        "summary": "Returns the result for an enrolment: the Participant who owns it, or the Organiser of its event.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The result.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResultResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultResponse"
                }
              }
            }
          },
          "403": {
            "description": "You are neither the enrolled Participant nor the event's Organiser."
          },
          "404": {
            "description": "Enrolment not found, or no result captured yet."
          }
        }
      }
    },
    "/api/events": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Creates a new event owned by the logged-in Organiser.",
        "description": "Body: eventName, eventType (Run / Walk / Cycle), eventDate, location, description. Distances are set per category.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Returns the new event ID."
          },
          "401": {
            "description": "Not logged in."
          },
          "403": {
            "description": "Logged in as a Participant."
          }
        }
      },
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Lists upcoming events (public). Add ?includePast=true to include events that have already happened.",
        "parameters": [
          {
            "name": "includePast",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of events, soonest first.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Returns full details of one event, including its categories (public).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The event and its categories.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetailResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetailResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Event not found."
          }
        }
      },
      "put": {
        "tags": [
          "Events"
        ],
        "summary": "Updates an event. Only the Organiser who created it may do this.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated event."
          },
          "403": {
            "description": "Not the owning Organiser."
          },
          "404": {
            "description": "Event not found."
          }
        }
      },
      "delete": {
        "tags": [
          "Events"
        ],
        "summary": "Deletes an event and its categories. Only the owning Organiser may do this.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "204": {
            "description": "Deleted."
          },
          "403": {
            "description": "Not the owning Organiser."
          },
          "404": {
            "description": "Event not found."
          },
          "409": {
            "description": "Participants are already enrolled, so the event cannot be deleted."
          }
        }
      }
    },
    "/api/events/{id}/categories": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Adds a category (e.g. 10km, 21km, Under 20) to an event. Owning Organiser only.",
        "description": "Body: categoryName, distanceKM, maxParticipants, entryFee.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Returns the new category ID."
          },
          "403": {
            "description": "Not the owning Organiser."
          },
          "404": {
            "description": "Event not found."
          }
        }
      },
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Lists all categories for an event (public).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of categories.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryResponse"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Event not found."
          }
        }
      }
    },
    "/api/events/{id}/enrolments": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Lists everyone enrolled in an event. Owning Organiser only.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of enrolments with participant and category details.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrganiserEnrolmentResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrganiserEnrolmentResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrganiserEnrolmentResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Not the owning Organiser."
          },
          "404": {
            "description": "Event not found."
          }
        }
      }
    },
    "/api/participants/me/history": {
      "get": {
        "tags": [
          "Participants"
        ],
        "summary": "Returns the logged-in Participant's full performance history across all past events.",
        "responses": {
          "200": {
            "description": "Array of results with event and category context, newest first.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoryItemResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoryItemResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoryItemResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Logged in as an Organiser."
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Returns the profile of the logged-in user (fields depend on their role).",
        "responses": {
          "200": {
            "description": "The profile.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in."
          }
        }
      },
      "put": {
        "tags": [
          "Profile"
        ],
        "summary": "Updates the logged-in user's profile.",
        "description": "Body: name, email, emergencyContact (participants), organisationName (organisers).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated profile.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields."
          },
          "409": {
            "description": "Email belongs to another user."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CategoryRequest": {
        "required": [
          "categoryName"
        ],
        "type": "object",
        "properties": {
          "categoryName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "distanceKM": {
            "maximum": 999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "maxParticipants": {
            "maximum": 100000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "entryFee": {
            "maximum": 999999.99,
            "minimum": 0,
            "type": "number",
