@model List<RaceDay.MVC.Models.OrganiserEnrolmentViewModel>

@{
    ViewData["Title"] = "Manage Participants";
}

<div class="container mt-4">

    <h2 class="mb-4">Manage Participants</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">
            @TempData["Message"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No participants have enrolled in this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Email</th>
                        <th>Emergency Contact</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                        <th>Result</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var participant in Model)
                    {
                        <tr>
                            <td>@participant.ParticipantName</td>
                            <td>@participant.ParticipantEmail</td>
                            <td>@participant.EmergencyContact</td>
                            <td>@participant.CategoryName</td>
                            <td>@participant.EnrolmentDate</td>
                            <td>@participant.Status</td>
                            <td>
                                @if (participant.HasResult)
                                {
                                    <span class="badge bg-success">Captured</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                @if (participant.HasResult)
                                {
                                    <a asp-action="EditResult"
                                       asp-route-id="@participant.EnrolmentId"
                                       asp-route-finishTime="@participant.FinishTime"
                                       asp-route-position="@participant.Position"
                                       asp-route-status="@participant.ResultStatus"
                                       class="btn btn-sm btn-warning">
                                        Edit Result
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="CaptureResult"
                                       asp-route-id="@participant.EnrolmentId"
                                       class="btn btn-sm btn-primary">
                                        Capture Result
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-action="Index" class="btn btn-secondary mt-3">
        Back to Events
    </a>

</div>
