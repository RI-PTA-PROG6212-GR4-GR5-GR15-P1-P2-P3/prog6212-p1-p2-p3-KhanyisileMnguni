@RaceDay.API_HostAddress = http://localhost:5164

### Register Organiser
POST {{HostAddress}}/api/Auth/register
Content-Type: application/json

{
  "name": "Test Organiser",
  "email": "organiser@raceday.com",
  "password": "Password123!",
  "role": "Organiser",
  "organisationName": "RaceDay Events"
}


###

### Register Participant
POST {{HostAddress}}/api/Auth/register
Content-Type: application/json

{
  "name": "Test Participant",
  "email": "participant@raceday.com",
  "password": "Password123!",
  "role": "Participant",
  "dateOfBirth": "2000-05-15",
  "emergencyContact": "0712345678"
}

###

### Login Organiser
POST {{HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "organiser@raceday.com",
  "password": "Password123!"
}

###

### Login Participant
POST {{HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "participant@raceday.com",
  "password": "Password123!"
}

###
