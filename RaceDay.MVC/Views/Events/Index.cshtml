@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4">
    <h1>Upcoming RaceDay Events</h1>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">@item.EventName</h5>

                    <p>@item.Description</p>

                    <p><strong>Date:</strong> @item.EventDate</p>

                    <p><strong>Location:</strong> @item.Location</p>

                    <p><strong>Organisation:</strong> @item.OrganisationName</p>

                    @* Organiser options *@
                    @if (Context.Session.GetString("Role") == "Organiser")
                    {
                        <a asp-controller="Events"
                           asp-action="AddCategory"
                           asp-route-id="@item.EventId"
                           class="btn btn-success w-100 mt-3">
                            + Add Event Category
                        </a>

                        <a asp-controller="Events"
                           asp-action="ManageParticipants"
                           asp-route-id="@item.EventId"
                           class="btn btn-primary w-100 mt-3">
                            Manage Participants
                        </a>

                        <form asp-controller="Events"
                              asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this event?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.EventId" />

                            <button type="submit"
                                    class="btn btn-outline-danger w-100 mt-3">
                                🗑 Delete Event
                            </button>
                        </form>
                    }

                    @* Participant options *@
                    @if (Context.Session.GetString("Role") == "Participant")
                    {
                        <a asp-controller="Events"
                           asp-action="Categories"
                           asp-route-id="@item.EventId"
                           class="btn btn-primary w-100 mt-3">
                            View Categories & Enrol
                        </a>
                    }

                </div>
            </div>
        </div>
    }

    </div>
    <div>
    @if (!Model.Any())
    {
        <p>No upcoming events are currently available.</p>
    }
</div>