@model RaceDay.MVC.Models.CategoryViewModel

<div class="container mt-4">
    <h1>Add Event Category</h1>

    <form asp-controller="Events"
          asp-action="AddCategory"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="EventID" />

        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label">
                Category Name
            </label>
            <input asp-for="CategoryName" class="form-control"
                   placeholder="e.g. 10km Road Race" />
        </div>

        <div class="mb-3">
            <label asp-for="DistanceKM" class="form-label">
                Distance (KM)
            </label>
            <input asp-for="DistanceKM" type="number"
                   step="0.1" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="MaxParticipants" class="form-label">
                Maximum Participants
            </label>
            <input asp-for="MaxParticipants" type="number"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="EntryFee" class="form-label">
                Entry Fee (R)
            </label>
            <input asp-for="EntryFee" type="number"
                   step="0.01" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Category
        </button>

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
