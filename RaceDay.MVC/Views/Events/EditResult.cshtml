@model RaceDay.MVC.Models.ResultViewModel

@{
    ViewData["Title"] = "Edit Race Result";
}

<div class="container mt-4">

    <h2>Edit Race Result</h2>

    <div class="card shadow-sm mt-3">
        <div class="card-body">

            <form asp-action="EditResult" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="EnrolmentId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FinishTime" class="form-label">
                        Finish Time (HH:MM:SS)
                    </label>
                    <input asp-for="FinishTime" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Position" class="form-label">
                        Finishing Position
                    </label>
                    <input asp-for="Position"
                           type="number"
                           min="1"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label">
                        Result Status
                    </label>
                    <select asp-for="Status" class="form-select">
                        <option value="Finished">Finished</option>
                        <option value="DNF">DNF</option>
                        <option value="DNS">DNS</option>
                        <option value="Disqualified">Disqualified</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-warning">
                    Update Result
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>
